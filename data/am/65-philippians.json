      "chapter": 1,
      "sections": [
        {
          "title": null,
          "verses": [
            {
              "verse": 1,
              "text": "የኢየሱስ፡ክርስቶስ፡ባሪያዎች፡የኾኑ፡ጳውሎስና፡ጢሞቴዎስ፡በፊልጵስዩስ፡ለሚኖሩ፡ከኤጲስ፡ቆጶሳትና፡ከዲያቆናት፡ጋራ፡በክርስቶስ፡ኢየሱስ፡ላሉት፡ቅዱሳን፡ዅሉ፤"
            },
            {
              "verse": 2,
              "text": "ከእግዚአብሔር፡ከአባታችን፡ከጌታም፡ከኢየሱስ፡ክርስቶስ፡ጸጋና፡ሰላም፡ለእናንተ፡ይኹን።"
            },
            {
              "verse": 3,
              "text": "ዅልጊዜ፡በጸሎቴ፡ዅሉ፡ስለ፡እናንተ፡ዅሉ፡በደስታ፡እየጸለይኹ፥ከፊተኛው፡ቀን፡እስከ፡ዛሬ፡ድረስ፡ወንጌልን፡በመስበክ፡ዐብራችኹ፡ስለ፡ሠራችኹ፥ባሰብዃችኹ፡ጊዜ፡ዅሉ፡አምላኬን፡አመሰግናለኹ።",
              "verse_end": 5
            },
            {
              "verse": 6,
              "text": "በእናንተ፡መልካምን፡ሥራ፡የዠመረው፡እስከኢየሱስ፡ክርስቶስ፡ቀን፡ድረስ፡እንዲፈጽመው፡ይህን፡ተረድቻለኹና፤"
            },
            {
              "verse": 7,
              "text": "በእስራቴም፡ወንጌልንም፡መመከቻና፡መጽኛ፡በማድረግ፡ዅላችኹ፡ከእኔ፡ጋራ፡በጸጋ፡ተካፋዮች፡ስለ፡ኾናችኹ፥በልቤ፡ትኖራላችኹና፡ስለ፡ዅላችኹ፡ይህን፡ላስብ፡ይገ፟ባ፟ኛል።"
            },
            {
              "verse": 8,
              "text": "በክርስቶስ፡ኢየሱስ፡ፍቅር፡ዅላችኹን፡እንዴት፡እንድናፍቃችኹ፡እግዚአብሔር፡ምስክሬ፡ነውና።"
            },
            {
              "verse": 9,
              "text": "ለእግዚአብሔርም፡ክብርና፡ምስጋና፡ከኢየሱስ፡ክርስቶስ፡የሚገኝ፡የጽድቅ፡ፍሬ፡ሞልቶባችኹ፥ለክርስቶስ፡ቀን፡ተዘጋጅታችኹ፡ቅኖችና፡አለ፡ነውር፡እንድትኾኑ፡የሚሻለውን፡ነገር፡ፈትናችኹ፡ትወዱ፡ዘንድ፥ፍቅራችኹ፡በዕውቀትና፡በማስተዋል፡ዅሉ፡ከፊት፡ይልቅ፡እያደገ፡እንዲበዛ፡ይህን፡እጸልያለኹ።",
              "verse_end": 11
            },
            {
              "verse": 12,
              "text": "ነገር፡ግን፥ወንድሞች፡ሆይ፥ይህ፡የደረሰብኝ፡በእውነት፡ወንጌልን፡ለማስፋት፡እንደ፡ኾነ፡ታውቁ፡ዘንድ፡እወዳለኹ።"
            },
            {
              "verse": 13,
              "text": "ስለዚህም፡እስራቴ፡ስለ፡ክርስቶስ፡እንዲኾን፡በንጉሥ፡ዘበኛዎች፡ዅሉና፡በሌላዎች፡ዅሉ፡ዘንድ፡ተገልጧል፥"
            },
            {
              "verse": 14,
              "text": "በጌታም፡ካሉት፡ወንድሞች፡የሚበዙት፡ስለ፡እስራቴ፡ታምነው፡የእግዚአብሔርን፡ቃል፡እንዲነግሩ፡ያለፍርሀት፡ከፊት፡ይልቅ፡ይደፍራሉ።"
            },
            {
              "verse": 15,
              "text": "አንዳንዶች፡ከቅንአትና፡ከክርክር፡እንኳ፡ሌላዎች፡ግን፡ከበጎ፡ፈቃድ፡የተነሣ፡ክርስቶስን፡ይሰብኩታል፤"
            },
            {
              "verse": 16,
              "text": "እነዚህ፡ወንጌልን፡መመከቻ፡ለማድረግ፡እንደ፡ተሾምኹ፡ዐውቀው፡በፍቅር፡ይሰብካሉ፥"
            },
            {
              "verse": 17,
              "text": "እነዚያ፡ግን፡በእስራቴ፡ላይ፡መከራን፡ሊያመጡብኝ፡መስሏቸው፥ለወገናቸው፡የሚጠቅም፡ፈልገው፡በቅን፡ዐሳብ፡ሳይኾኑ፡ስለ፡ክርስቶስ፡ያወራሉ።"
            },
            {
              "verse": 18,
              "text": "ምን፡አለ፧ቢኾንም፡በዅሉ፡ጐዳና፥በማመካኘት፡ቢኾን፡ወይም፡በቅንነት፡ቢኾን፥ክርስቶስ፡ይሰበካል፡ስለዚህም፡ደስ፡ብሎኛል።"
            },
            {
              "verse": 19,
              "text": "ወደ፡ፊትም፡ደግሞ፡ደስ፡ይለኛል፤ይህ፡በጸሎታችኹና፡በኢየሱስ፡ክርስቶስ፡መንፈስ፡መሰጠት፡ለመዳኔ፡እንዲኾንልኝ፡ዐውቃለኹና፥"
            },
            {
              "verse": 20,
              "text": "ይህ፡ናፍቆቴ፡ተስፋዬም፡ነውና፤ባንድ፡ነገር፡እንኳ፡አላፍርም፥ነገር፡ግን፥በሕይወት፡ብኖር፡ወይም፡ብሞት፥ክርስቶስ፡በግልጥነት፡ዅሉ፡እንደ፡ወትሮው፡አኹን፡ደግሞ፡በሥጋዬ፡ይከብራል።"
            },
            {
              "verse": 21,
              "text": "ለእኔ፡ሕይወት፡ክርስቶስ፥ሞትም፡ጥቅም፡ነውና።"
            },
            {
              "verse": 22,
              "text": "ነገር፡ግን፥በሥጋ፡መኖር፡ለእኔ፡የሥራ፡ፍሬ፡ቢኾን፥ምን፡እንድመርጥ፡አላስታውቅም።"
            },
            {
              "verse": 23,
              "text": "በእነዚህም፡በኹለቱ፡እጨነቃለኹ፤ልኼድ፡ከክርስቶስም፡ጋራ፡ልኖር፡እናፍቃለኹ፥ከዅሉ፡ይልቅ፡እጅግ፡የሚሻል፡ነውና፤"
            },
            {
              "verse": 24,
              "text": "ነገር፡ግን፥በሥጋ፡መኖሬ፡ስለ፡እናንተ፡እጅግ፡የሚያስፈልግ፡ነው።"
