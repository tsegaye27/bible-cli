            {
              "verse": 20,
              "text": "በዘለዓለም፡ኪዳን፡ደም፡ለበጎች፡ትልቅ፡እረኛ፡የኾነውን፡ጌታችንን፡ኢየሱስን፡ከሙታን፡ያወጣው፡የሰላም፡አምላክ፥"
            },
            {
              "verse": 21,
              "text": "በኢየሱስ፡ክርስቶስ፡በኩል፡በፊቱ፡ደስ፡የሚያሠኘውን፡በእናንተ፡እያደረገ፥ፈቃዱን፡ታደርጉ፡ዘንድ፡በመልካም፡ሥራ፡ዅሉ፡ፍጹማን፡ያድርጋችኹ፤ለርሱ፡እስከ፡ዘለዓለም፡ድረስ፡ክብር፡ይኹን፤አሜን።"
            },
            {
              "verse": 22,
              "text": "ወንድሞች፡ሆይ፥የምክርን፡ቃል፡እንድትታገሡ፡እመክራችዃለኹ፥በጥቂት፡ቃል፡ጽፌላችዃለኹና።"
            },
            {
              "verse": 23,
              "text": "ወንድማችን፡ጢሞቴዎስ፡እንደ፡ተፈታ፡ዕወቁ፥ቶሎ፡ብሎም፡ቢመጣ፡ከርሱ፡ጋራ፡አያችዃለኹ።"
            },
            {
              "verse": 24,
              "text": "ለዋኖቻችኹ፡ዅሉና፡ለቅዱሳን፡ዅሉ፡ሰላምታ፡አቅርቡልኝ።ከኢጣልያ፡የኾኑቱ፡ሰላምታ፡ያቀርቡላችዃል።"
            },
            {
              "verse": 25,
              "text": "ጸጋ፡ከዅላችኹ፡ጋራ፡ይኹን፤አሜን፨"
            }
          ]
        }
      ]
    }
  ]
}